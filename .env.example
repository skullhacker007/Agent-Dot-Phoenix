# --- Vision market-data pipelines (temporary test UI) ---
# Upstox ANALYTICS access token (Market Data only, no trading) for the Indian
# Equities pipeline. Server-side only: never exposed to the browser.
# This is deliberately separate from the algo-trading credentials
# (UPSTOX_API_KEY / UPSTOX_API_SECRET / UPSTOX_ACCESS_TOKEN), which this code
# never reads. Leave empty to show "Not configured".
UPSTOX_ANALYTICS_TOKEN=
# Upstox API base URL override (e.g. sandbox for testing). Optional.
UPSTOX_API_BASE=
# Shared fetch/cache tuning, in milliseconds. Optional.
MARKET_DATA_CACHE_TTL_MS=
UPSTOX_TIMEOUT_MS=
# How many instruments each pipeline shows. Every pipeline discovers its
# universe at runtime; this only caps how much of it is rendered.
# Optional, default 12.
MARKET_DATA_UNIVERSE_LIMIT=
# Base currency the FX universe is quoted against (ECB reference rates).
# Optional, default EUR.
MARKET_DATA_FX_BASE=
# Domestic currency used for the derived cross-rate row. Optional, default INR.
MARKET_DATA_FX_DOMESTIC=
# Quote asset the crypto universe is filtered to. Optional, default USDT.
MARKET_DATA_CRYPTO_QUOTE_ASSET=
# Comma-separated search queries used to discover index instruments at
# runtime. These are search terms, not instrument identifiers; the symbols
# and labels always come from the provider's response. Optional.
MARKET_DATA_INDEX_QUERIES=
# Comma-separated search queries used to discover commodity instruments at
# runtime. Optional.
MARKET_DATA_COMMODITY_QUERIES=
